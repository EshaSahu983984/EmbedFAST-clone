            "nullable": true
          },
          "filters": {
            "type": "array",
            "items": {},
            "nullable": true
          },
          "columns": {
            "type": "array",
            "items": {},
            "nullable": true
          },
          "measures": {
            "type": "array",
            "items": {},
            "nullable": true
          }
        },
        "additionalProperties": false
