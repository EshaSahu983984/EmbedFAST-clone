            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChatRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "reportId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "datasetId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
